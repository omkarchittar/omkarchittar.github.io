{% assign education = data[1] | sort: 'startDate' | reverse %}
{% for content in education %}
  <article class="resume-entry">
    <div class="resume-entry-heading">
      <div>
        <h3 data-toc-skip>
          {{ content.studyType -}}
          {%- if content.area != blank %} in {{ content.area }}{% endif %}
        </h3>
        <p class="resume-organization">
          {% if content.url != blank -%}
            <a href="{{ content.url }}">{{ content.institution }}</a>
          {%- else -%}
            {{- content.institution -}}
          {%- endif %}
        </p>
      </div>
      {% if content.startDate != blank %}
        <p class="resume-date">
          {{ content.startDate | date: '%b %Y' -}}
          {%- if content.endDate != blank %} — {{ content.endDate | date: '%b %Y' }}{% endif %}
        </p>
      {% endif %}
    </div>
    {% if content.score != blank %}
      <p>CGPA: {{ content.score }}</p>
    {% endif %}
    {% if content.courses.size > 0 %}
      <p class="resume-coursework">{{ content.courses | join: ' · ' }}</p>
    {% endif %}
  </article>
{% endfor %}
