<footer class="editorial-footer {% if site.footer_fixed %}fixed-bottom{% else %}sticky-bottom{% endif %}" role="contentinfo">
  <div class="container">
    <span
      >&copy; {{ site.time | date: '%Y' }}
      {{ site.first_name }}
      {{ site.last_name }}. {{ site.footer_text -}}
    </span>
    <nav aria-label="Social links">
      <a href="https://github.com/{{ site.github_username }}">GitHub ↗</a>
      <a href="https://www.linkedin.com/in/{{ site.linkedin_username }}">LinkedIn ↗</a>
      <a href="{{ '/cv/' | relative_url }}">Résumé ↗</a>
    </nav>
    {% if site.impressum_path -%}
      <a href="{{ site.impressum_path | relative_url }}">Impressum</a>
    {%- endif %}
    {% if site.last_updated -%}
      <span>Updated {{ 'now' | date: '%B %d, %Y' }}</span>
    {%- endif %}
  </div>
</footer>
