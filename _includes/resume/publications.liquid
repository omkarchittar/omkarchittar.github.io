{% assign publications = data[1] | sort: 'releaseDate' | reverse %}
{% for content in publications %}
  <article class="resume-entry">
    <div class="resume-entry-heading">
      <h3 data-toc-skip>
        <a href="{{ content.url }}">{{ content.name }}</a>
      </h3>
      <p class="resume-date">{{ content.releaseDate }}</p>
    </div>
    <p class="resume-organization">{{ content.publisher }}</p>
  </article>
{% endfor %}
