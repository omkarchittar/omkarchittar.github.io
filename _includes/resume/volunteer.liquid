{% assign volunteer = data[1] | sort: 'startDate' | reverse %}
{% for content in volunteer %}
  <article class="resume-entry">
    <div class="resume-entry-heading">
      <div>
        <h3 data-toc-skip>
          {% if content.url != blank -%}
            <a href="{{ content.url }}">{{ content.position }}</a>
          {%- else -%}
            {{- content.position -}}
          {%- endif %}
        </h3>
        <p class="resume-organization">{{ content.organization }}</p>
      </div>
      {% if content.startDate != blank %}
        <p class="resume-date">
          {{ content.startDate | date: '%b %Y' -}}
          {%- if content.endDate != blank %}
            — {% if content.endDate == 'Present' %}Present{% else %}{{ content.endDate | date: '%b %Y' }}{% endif -%}
          {%- endif %}
        </p>
      {% endif %}
    </div>
    {% include resume/summary.liquid summary=content.summary %}
    {% if content.highlights.size > 0 %}
      <ul class="resume-bullets">
        {% for item in content.highlights %}
          <li>{{ item }}</li>
        {% endfor %}
      </ul>
    {% endif %}
  </article>
{% endfor %}
