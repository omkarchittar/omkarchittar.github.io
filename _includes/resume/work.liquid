{% assign work = data[1] | sort: 'startDate' | reverse %}
{% for content in work %}
  <article class="resume-entry{% if content.earlier %} resume-earlier{% endif %}">
    {% if content.earlier %}
      <p class="eyebrow">Earlier Work</p>
    {% endif %}
    <div class="resume-entry-heading">
      <div>
        <h3 data-toc-skip>
          {% if content.url != blank %}
            <a href="{{ content.url }}">{{ content.position }}</a>
          {% else %}
            {{ content.position }}
          {% endif %}
        </h3>
        <p class="resume-organization">
          {{ content.name -}}
          {%- if content.location != blank %} · {{ content.location }}{% endif %}
        </p>
      </div>
      {% if content.startDate != blank %}
        <p class="resume-date">
          {{ content.startDate | date: '%b %Y' }} —
          {% if content.endDate == blank or content.endDate == 'Present' %}Present{% else %}{{ content.endDate | date: '%b %Y' }}{% endif %}
        </p>
      {% endif %}
    </div>
    {% include resume/summary.liquid summary=content.summary %}
    {% if content.highlights.size > 0 %}
      <ul class="work-tags" aria-label="Role focus">
        {% for item in content.highlights %}
          <li>{{ item }}</li>
        {% endfor %}
      </ul>
    {% endif %}
  </article>
{% endfor %}
